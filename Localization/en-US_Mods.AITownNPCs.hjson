Follow: {
	Start: "{0}; started following ({1})"
	Stop: "{0}; stopped following ({1})"
	NoNpcNearby: No followable NPC nearby — stand closer and say the start keyword
	NoFollower: No NPC is following you
	NpcBusy: This NPC is already following another player
	CastingBusy: This NPC is casting and cannot follow right now.
}

Ai: {
	Unavailable: AI unavailable (check API key or network)
	RateLimited: You're talking too fast — the NPC can't keep up.
	NoModelAutoDisabled: "{0} has no available language model; AI chat and superpowers have been disabled"
}

Config: {
	Headers: {
		Follow: Dialogue Follow
		Ai: AI Chat
		Superpower: NPC Superpowers
	}

	FollowTriggerDistance: {
		Label: Follow / chat distance
		Tooltip: Fixed pixels 50/100/200/300/400 for follow keywords and typed AI chat only — does not affect lost-NPC teleport. Walk-by is fixed 50px, 10s stay, 10min per NPC (typing also starts CD); @NPC name works map-wide; typing itself has no cooldown
	}

	FollowLostTeleportDistance: {
		Label: Lost teleport distance
		Tooltip: While following, if farther than this for about 5 seconds the NPC mirror-teleports to you. Independent of follow/chat distance. A hard cap near 2000px teleports immediately. Default 800 (~50 tiles)
	}

	Defaults: {
		FollowStartKeyword: follow me
		FollowStopKeyword: go away
	}

	FollowStartKeyword: {
		Label: Start keyword
		Tooltip: Leave blank to use the game-language default (English: follow me); a filled value overrides it
	}

	FollowStopKeyword: {
		Label: Stop keyword
		Tooltip: Leave blank to use the game-language default (English: go away); a filled value overrides it
	}

	AiEnabled: {
		Label: Enable AI chat
		Tooltip: Nearby town NPC replies when you type in chat
	}

	ProviderId: {
		Label: Model provider
		Tooltip: MiniMax / Volcengine Ark / Custom (OpenAI-compatible). Built-in CN endpoints, or paste any overseas-compatible base URL
	}

	Provider: {
		Label: Model provider
		Tooltip: MiniMax / Volcengine Ark / Custom (OpenAI-compatible). Built-in CN endpoints, or paste any overseas-compatible base URL
	}

	BaseUrl: {
		Label: Base URL
		Tooltip: OpenAI-compatible root (e.g. https://api.openai.com/v1 or a Google-compatible / proxy gateway). Do not include /chat/completions. Only Custom saves edits; CN providers show the built-in URL
	}

	Model: {
		Label: Model
		Tooltip: Model id for the selected provider; empty uses that provider's default
	}

	ApiKey: {
		Label: API Key
		Tooltip: Key for the selected provider; host/server only — do not share
	}

	AiMaxTokens: {
		Label: Max tokens
		Tooltip: Reply length cap for chat
	}

	AiShortTermTurns: {
		Label: Short-term memory entries
		Tooltip: Recent dialogue and events per player-NPC (default 20); trim chat before events when full
	}

	AiProactiveEnabled: {
		Label: Enable proactive speech
		Tooltip: Walk-by (50px, 10s stay, 10min CD; typing also starts CD); follower chatter about every 2 minutes with 50% chance. Typing itself has no cooldown
	}

	AutoJoinRedTeam: {
		Label: Auto-join red team
		Tooltip: Join the red team ~5 seconds after entering a world (MP testing); off by default
	}

	SuperpowerEnabled: {
		Label: Enable superpowers
		Tooltip: Chat AI detects intent and runs town NPC superpowers
	}
}

Buffs: {
	ArmsDealerWeaponBuff: {
		DisplayName: Arms Dealer Loan
