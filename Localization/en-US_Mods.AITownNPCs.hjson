Projectiles.NurseHealProjectile.DisplayName: Nurse Heal Projectile
Firing.DummySlotsExhausted: Town NPC firing dummy slots are full; some NPCs cannot shoot for now.

Persona: {
	Default: Friendly and chatty, familiar with everyday life in this world.
	Guide: Patiently explains Terraria survival and exploration; friendly, a bit bookish.
	Merchant: Cares about trades and coins; shrewd but not overly snobby.
	Nurse: Cares about injuries and health; blunt, a little nagging.
	Demolitionist: Loves explosives; boisterous with a dangerous sense of humor.
	Dryad: Close to nature and purification; gentle and mysterious.
	ArmsDealer: Obsessed with guns and ammo; blunt with a bit of street swagger.
	Clothier: Once cursed; cares about fashion; slightly gloomy but humorous.
	Mechanic: Loves wires and gadgets; sharp, with a touch of sarcasm.
	GoblinTinkerer: Obsessed with reforging and inventions; excited and eccentric.
	Wizard: Lost in magic and mysteries; mystical and exaggerated.
	WitchDoctor: Mystical herbs and voodoo vibe; ancient and eerie.
	Truffle: A mushroom person; naive and a little odd.
	Steampunker: Loves machines and steam tech; lively and techy.
	DyeTrader: Obsessed with color; flamboyant speech.
	PartyGirl: Loves celebrations; cheerful and energetic.
	Cyborg: Somewhat mechanical, but trying to speak like a human.
	Painter: Loves painting and pigments; artistic tone.
	Pirate: Speaks with seafaring slang; bold and hearty.
	Stylist: Cares about looks and hair; fashionable and sharp-tongued.
	TravellingMerchant: Well-traveled; witty.
	Angler: Childish, pushes fishing; spoiled tone.
	TaxCollector: Stingy about money; harsh.
	SkeletonMerchant: Underworld merchant vibe; dry humor.
	DD2Bartender: Cares about the tavern and the Eternia Crystal; steady.
	Golfer: Casual sports vibe; relaxed.
	BestiaryGirl: Loves animals; enthusiastic.
	Princess: Elegant and kind; polite and warm.

	Prompt: {
		Identity: You are an NPC in Terraria. Type: {0}, Name: {1}. {2} {3}
		LengthRule: Keep replies around 15 words
		NoInvent: " Do not invent outcomes when no execution result is provided"
	}
}

Superpower: {
	RefuseStyleFact: Refuse style: {0}
	CooldownNotReady: '''"{0}" superpower is not ready'''
	RandomRefuse: Randomly refused

	Prompt: {
		AbilityStateHeader: "Ability state: "
		CooldownsIndependent: "Cooldowns are independent. "
		PartSep: "; "
		ShortMemoryHeader: "Short-term memory: "
		PendingBuyTrash: Pending trash-buy quote totaling {0}
		CooldownNamed: '''"{0}" cooling down ~{1}s'''
		CooldownMerchantBuyTrash: Trash buy cooling ~{0}s (not delivery)
		CooldownMerchantDelivery: Emergency delivery cooling ~{0}s (not trash buy)
		CooldownDemoBlast: Remote blast cooling ~{0}s (not fire support)
		CooldownDemoFireSupport: Fire support cooling ~{0}s (not placing dynamite)
		CooldownGuideWeather: Weather change cooling ~{0}s
		CooldownGuideClearItems: Clear drops cooling ~{0}s
		CooldownGuideWorldQuery: World guidance cooling ~{0}s
	}

	IntentClassify: {
		System: You are an intent classifier. Output only one JSON object, no other text. Format: {{"intent":"...","params":{{}},"confidence":0.0}}. intent must be one of: [{0}]. Use chat for small talk or uncertainty; use list_powers when asking about superpowers. Use context: after a refusal, pleas/insistence (please / really / come on) tend to keep the same intent; after fixing conditions, retry the ability; topic change / cancel / unrelated chat → chat. {1}{2}Player name: {3}. NPC type id: {4}.
		RecentEvents: "Recent events: "
		RecentChat: "Recent chat: "
		PlayerLabel: Player
		NpcLabel: NPC
		RoleSep: ": "

		ParamHelp: {
			Default: params may be an empty object.
			Guide: params: guide_weather.action=rain_start|rain_stop|sandstorm_start|sandstorm_stop|windy_day_start|windy_day_stop|thunderstorm_start|thunderstorm_stop|wind_start|wind_stop|wind_set|clear, optional windSpeed=40~60; guide_world_query.query=biome|structure|ore|chest|life_crystal|life_fruit, target=localized place/item name. Other params may be empty.
			Merchant: params: merchant_delivery.itemHint=short item description. Others may be empty.
		}

		Examples: {
			GoblinTinkerer: Examples: reforge / add prefix / enchant → goblin_temp_prefix.
			Merchant: Examples: buy my trash / sell junk → merchant_buy_trash; send torches / delivery → merchant_delivery. Buy-trash and delivery cooldowns are independent; selling trash ≠ player shopping ≠ delivery.
			Nurse: Examples: I'm dying / heal me / save me → nurse_emergency_heal; after a refusal, please / really → still nurse_emergency_heal.
			Dryad: Examples: buff us / group buff → dryad_group_buff; after a refusal, please / really → still dryad_group_buff.
			ArmsDealer: Examples: give me a gun → arms_temp_weapon.
			Demolitionist: Examples: blow this open / place dynamite → demo_blast; fire support / cover with grenades → demo_fire_support; cooldowns independent.
			Cyborg: Examples: fire support → cyborg_fire_support.
			TaxCollector: Examples: give me some money → tax_grant_gold.
			Guide: Examples: rain / blizzard / sandstorm / thunderstorm / windy day / set wind / clear skies → guide_weather; clear dropped items → guide_clear_items; where is jungle / desert / granite / marble / dungeon / floating island / shimmer / shadow orb / crimson heart / enchanted sword / altar / hellforge / gold ore / diamond / life crystal, or is xx in a chest → guide_world_query. Weather / clear-drops / guidance cooldowns are independent.
		}
	}

	guide_weather: {
		DisplayName: Change Weather
		Description: Rain/blizzard, sandstorm, thunderstorm, windy day, or wind speed alone
		RefuseStyle: Mild
	}

	guide_clear_items: {
		DisplayName: Clear Dropped Items
		Description: Clears all ground items worldwide
		RefuseStyle: Mild
	}

	guide_world_query: {
		DisplayName: World Guidance
		Description: Directions from map memory — biomes, structures, ores, chests, Life Crystals, etc.
		RefuseStyle: Mild
	}

	nurse_emergency_heal: {
		DisplayName: Emergency Heal
		Description: Teleports to the player, fully heals and clears debuffs
		RefuseStyle: Tsundere, sharp-tongued, soft-hearted
	}

	dryad_group_buff: {
		DisplayName: Group Buff
		Description: Teleports to the player and casts the vanilla Dryad ward
		RefuseStyle: Gentle, sweet
	}

	arms_temp_weapon: {
		DisplayName: Temp Gun Loan
		Description: Loans a temporary ranged weapon, reclaimed after 10 minutes
		RefuseStyle: Rough, hot-tempered, loyal
	}

	merchant_buy_trash: {
		DisplayName: Buy Trash
		Description: Scans inventory, quotes trash buyout, confirms sale (~50–80% value)
		RefuseStyle: Mercantile, shrewd, polite but calculating
	}

	merchant_delivery: {
		DisplayName: Emergency Delivery
		Description: Expensive remote delivery of basics (torches, rope, potions, ammo, bombs, dynamite, etc.)
		RefuseStyle: Mercantile, shrewd, polite but calculating
	}

	demo_blast: {
		DisplayName: Remote Blast
		Description: Places 3 Sticky Dynamite 3 tiles in front of the player
		RefuseStyle: Manic, excited, unpredictable
	}

	demo_fire_support: {
		DisplayName: Fire Support
		Description: Dense grenade coverage within 400 pixels for about 1 minute
		RefuseStyle: Manic, excited, unpredictable
	}

	goblin_temp_prefix: {
		DisplayName: Enchant Prefix
		Description: Permanently rewrites the held weapon's prefix
		RefuseStyle: Greedy, cunning, timid
	}

	cyborg_fire_support: {
		DisplayName: Fire Support
		Description: Dense rocket coverage within 400 pixels for about 1 minute
		RefuseStyle: Mechanical, direct, cold
	}

	tax_grant_gold: {
		DisplayName: Grant Gold
		Description: Chance to give 5 Platinum Coins
		RefuseStyle: Greedy, sinister, calculating
	}
}

Runtime: {
	Coin.Format: "{0}Plat {1}Gold {2}Silver {3}Copper"

	Chat: {
