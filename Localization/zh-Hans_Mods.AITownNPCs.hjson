Items: {
	ReinforcementHeart: {
		DisplayName: 强化之心
		Tooltip:
			'''
			装备于 NPC「强化之心」槽
			每枚提供 +500 生命上限，最多叠加 20
			'''
	}
}

UI: {
	Equip: 装备
	WeaponSlot: 武器
	AmmoSlot: 弹药
	HeartSlot: 血量
	HeartSlotOnly: 只能放入强化之心或生命水晶（最多 20 个）
	WingSlot: 翅膀
	WingSlotOnly: 只能放入翅膀
	PotionSlotA: HP
	PotionSlotB: MP
	LifePotionOnly: HP 格只能放回血药水
	ManaPotionOnly: MP 格只能放回蓝药水
	BuffSlot1: 增益1
	BuffSlot2: 增益2
	BuffSlot3: 增益3
	BuffSlot4: 增益4
	BuffSlot5: 增益5
	BuffSlot6: 增益6
	BuffSlot7: 增益7
	BuffSlot8: 增益8
	BuffSlot9: 增益9
	BuffSlot10: 增益10
	BuffPotionOnly: 树妖只能装备增益药水
	AmmoNotSupported: 不支持该弹药
	WeaponNotSupported: 不支持该类型装备
	EquipBusy: 该 NPC 装备栏正被其他玩家使用
	CombatBusy: NPC战斗忙碌中
	FollowInteractBlocked: NPC正在跟随（{0}），无法使用交互。
	ChatTabAll: 全部
	ChatTabFollow: 跟随
	ChatFollowEmpty: （跟随频道暂无消息）
}

Follow: {
	Start: "{0}；开始跟随（{1}）"
	Stop: "{0}；停止跟随（{1}）"
	NoNpcNearby: 附近没有可跟随的 NPC（靠近后再说「跟着我」）
	NoFollower: 当前没有 NPC 在跟随你
	NpcBusy: 该 NPC 正在跟随其他玩家
	CastingBusy: NPC正在施法，暂时无法跟随。
}

Ai: {
	Unavailable: AI 暂不可用（检查 API Key 或网络）
	RateLimited: 你发言的太快了，NPC反应不过来
	NoModelAutoDisabled: "{0}没有可用的大模型，AI对话与超能力已自动关闭"
}

Config: {
	Headers: {
		Follow: 对话跟随
		Ai: AI 对话
		Superpower: NPC 超能力
	}

	FollowTriggerDistance: {
		Label: 跟随/对话距离
		Tooltip: 固定选项（像素）：50 / 100 / 200 / 300 / 400；只用于「跟着我」和玩家主动打字，不影响走丢传送。路过招呼固定 50px、停留 10 秒、同 NPC 10 分钟冷却（打字也计入）；聊天框 @NPC 名可全图呼叫；打字无冷却
	}

	FollowLostTeleportDistance: {
		Label: 走丢传送距离
		Tooltip: 跟随中离主人超过该距离并持续约 5 秒，会镜子传送回身边。与「跟随/对话距离」无关。另有硬上限约 2000 像素会立刻传送。默认 800（约 50 格）
	}

	Defaults: {
		FollowStartKeyword: 跟着我
		FollowStopKeyword: 你走吧
	}

	FollowStartKeyword: {
		Label: 启动关键词
		Tooltip: 留空则按游戏语言使用默认（中文：跟着我）；填写后只用你设的词
	}

	FollowStopKeyword: {
		Label: 停止关键词
		Tooltip: 留空则按游戏语言使用默认（中文：你走吧）；填写后只用你设的词
	}

	AiEnabled: {
		Label: 启用 AI 对话
		Tooltip: 靠近城镇 NPC 时，聊天框普通发言会触发 AI 回复
	}

	ProviderId: {
		Label: 模型提供商
		Tooltip: MiniMax / 火山方舟 / 自定义端点（OpenAI 兼容）；国内两家地址内置，自定义可接国外网关
	}

	Provider: {
		Label: 模型提供商
		Tooltip: MiniMax / 火山方舟 / 自定义端点（OpenAI 兼容）；国内两家地址内置，自定义可接国外网关
	}

	BaseUrl: {
		Label: 接口地址
		Tooltip: OpenAI 兼容根路径（如 https://api.openai.com/v1）；不要带 /chat/completions。仅「自定义端点」可改并保存；国内两家显示内置地址
	}

	Model: {
		Label: 模型
		Tooltip: 当前提供商的模型名；为空时用该提供商默认
	}

	ApiKey: {
		Label: API Key
		Tooltip: 当前提供商的密钥；仅主机/服务器，勿泄露
	}

	AiMaxTokens: {
		Label: 最大生成 Token
		Tooltip: 对话回复长度上限
	}

	AiShortTermTurns: {
		Label: 短期记忆条数
		Tooltip: 每个玩家与每个 NPC 的近期对话与事件（默认 20）；满时优先删闲聊、保留大事
	}

	AiProactiveEnabled: {
		Label: 启用主动发言
		Tooltip: 路过招呼（50px、停满10秒、10分钟冷却，打字也计入）；跟随碎碎念约每2分钟有50%概率开口。玩家主动打字本身无冷却
	}

	AutoJoinRedTeam: {
		Label: 进世界自动红队
		Tooltip: 进入世界约 5 秒后加入红队（联机测试用）；默认关闭
	}

	SuperpowerEnabled: {
		Label: 启用超能力
		Tooltip: 对话经 AI 识别意图后触发城镇 NPC 超能力
	}
}

Buffs: {
	ArmsDealerWeaponBuff: {
		DisplayName: 军火商配枪
		Description: 临时借用军火商的枪（仅限背包自用），10 分钟后自动收回
	}

	GuideGuidanceBuff: {
		DisplayName: 向导指引
		Description: 头顶箭头指向目标方向，持续 10 分钟
	}

	SuperHeartBuff: {
		DisplayName: 护士爱心
		Description: 每秒额外回复 50 点生命，持续 3 分钟
	}
}

